node_modules/
playwright-report/
test-results/

# Android build outputs and anything keystore/signing related — the
# release.keystore file only ever exists locally or briefly inside a CI
# run (decoded from a secret, never committed); build/ and .gradle/ are
# regenerated by Gradle and shouldn't be versioned.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/**/release.keystore
*.keystore
*.jks

# iOS signing material — same reasoning as the Android keystore above.
# Capacitor's own ios/.gitignore already covers build outputs/Pods/etc.
ios/**/*.mobileprovision
ios/**/*.p12
*.p12
